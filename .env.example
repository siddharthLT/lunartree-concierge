# Copy to .env and fill in for local development.
# In production, set these as real environment variables on the host instead.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# Postgres connection string (e.g. from Neon). Leave unset to fall back to SQLite.
DATABASE_URL=

# Slack incoming webhook for new-request notifications (optional).
SLACK_WEBHOOK_URL=

# Email notifications (search interests etc.). Without EMAIL_HOST mail is only logged to the console.
NOTIFY_EMAIL=siddharth@lunartree.bio
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
